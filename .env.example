# Canvas LMS Configuration
# Your Canvas instance URL (e.g. https://yourschool.instructure.com)
CANVAS_API_URL=https://kings.instructure.com

# Canvas API token — generate from Canvas > Account > Settings > New Access Token
CANVAS_API_TOKEN=

# Database — overridden by docker-compose for local dev
# For production (Supabase + Render): postgresql+asyncpg://user:pass@host:5432/db?ssl=require
DATABASE_URL=postgresql+asyncpg://kings:kings@db:5432/kings_analytics

# Sync interval in hours (default: 24)
SYNC_INTERVAL_HOURS=24

# Incremental sync interval in minutes (default: 30)
INCREMENTAL_SYNC_INTERVAL_MINUTES=30

# Reminder digest scheduling
REMINDER_TIMEZONE=Australia/Sydney
REMINDER_SCHEDULER_INTERVAL_SECONDS=60

# Reminder email delivery
# Set to true only after SMTP is configured.
REMINDER_EMAIL_ENABLED=false
REMINDER_EMAIL_FROM_NAME=Kings Track
REMINDER_EMAIL_FROM_ADDRESS=

# Temporary reminder test routing
# While enabled, the job sends exactly 1 student email, 1 parent email,
# and 1 school email for the first student/course found, all to the same inbox.
REMINDER_TEST_MODE_ENABLED=true
REMINDER_TEST_RECIPIENT_EMAIL=liam22840@gmail.com

# SMTP settings for reminder emails
REMINDER_SMTP_HOST=
REMINDER_SMTP_PORT=587
REMINDER_SMTP_USERNAME=
REMINDER_SMTP_PASSWORD=
REMINDER_SMTP_STARTTLS=true
REMINDER_SMTP_USE_SSL=false
REMINDER_SMTP_TIMEOUT_SECONDS=30

# CORS allowed origins (comma-separated)
# For production set to your Vercel URL(s): https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth mode
# Local dev should use "local" so the app does not depend on Supabase.
# Production can use "supabase".
AUTH_MODE=local
LOCAL_DEV_USER_EMAIL=admin@local.dev
LOCAL_DEV_USER_ROLE=admin

# Supabase project URL — used to fetch JWKS for JWT verification
# e.g. https://yourproject.supabase.co
SUPABASE_URL=

# AI chat assistant (Google Gemini)
# Create a key at https://aistudio.google.com/app/apikey
# Leave blank to disable the in-app AI assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cron secret — protects GET /api/sync/trigger from unauthorized callers.
# On Vercel, set this and pass it via x-cron-secret header in vercel.json crons.
# Leave blank in local dev to keep the endpoint open.
CRON_SECRET=

# Environment & deployment
ENVIRONMENT=development
DEPLOYMENT_TARGET=docker

# Redis
# Local Docker:       redis://redis:6379/0
# Upstash (Vercel):   rediss://default:<password>@<region>.upstash.io:6379
# Azure Cache:        rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0
REDIS_URL=

# Vercel function timeout (seconds) — used for sync lock TTL
VERCEL_FUNCTION_TIMEOUT=300

# Database pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
