{
  "manifest_version": 3,
  "name": "Kings Track Gradeo Importer",
  "version": "0.2.0",
  "description": "Push Gradeo data into the Kings Track dashboard via an open bridge tab — no API key required.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://platform.gradeo.com.au/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "vendor/webextension-polyfill.js",
      "src/shared/config.js",
      "src/shared/logger.js",
      "src/shared/auth.js",
      "src/shared/csv.js",
      "src/shared/gradeoSession.js",
      "src/background/index.js"
    ],
    "service_worker": "src/background/worker.js",
    "preferred_environment": [
      "service_worker",
      "document"
    ]
  },
  "action": {
    "default_title": "Kings Track Gradeo",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://platform.gradeo.com.au/*"],
      "js": [
        "vendor/webextension-polyfill.js",
        "src/shared/gradeoSession.js",
        "src/content/gradeoSession.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://platform.gradeo.com.au/admin/schoolStudents*"],
      "js": [
        "vendor/webextension-polyfill.js",
        "src/shared/config.js",
        "src/shared/logger.js",
        "src/shared/csv.js",
        "src/content/schoolStudents.parsers.js",
        "src/content/schoolStudents.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://platform.gradeo.com.au/admin/schoolGroups*"],
      "js": [
        "vendor/webextension-polyfill.js",
        "src/shared/config.js",
        "src/shared/logger.js",
        "src/shared/csv.js",
        "src/content/schoolGroups.parsers.js",
        "src/content/schoolGroups.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://platform.gradeo.com.au/reporting*"],
      "js": [
        "vendor/webextension-polyfill.js",
        "src/shared/config.js",
        "src/shared/logger.js",
        "src/shared/csv.js",
        "src/shared/dom.js",
        "src/content/reporting.sync.js",
        "src/content/reporting.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*/extension-bridge*"
      ],
      "js": [
        "vendor/webextension-polyfill.js",
        "src/content/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/gradeoSession.page.js"],
      "matches": ["https://platform.gradeo.com.au/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gradeo-import@kings-track.local"
    }
  }
}
